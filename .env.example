# 本文件是环境变量样例，不包含真实密钥。
# Docker Compose 在从项目根执行 deploy/docker-compose.yml 时读取根目录 .env 做变量替换。
# 本地 Python 后端不会自动加载 .env；本地运行请在 shell 中 export/set 所需变量。

# 仅用于本地演示也必须替换；生产部署还需重做认证与凭据管理。
MEDICAL_SECRET_KEY=replace-with-a-long-random-local-secret
MEDICAL_TOKEN_MINUTES=480
# 患者标识散列盐应在首次ETL前固定并妥善保管，变更会改变patient_key。
MEDICAL_HASH_SALT=replace-with-a-stable-local-salt

# 可选。未设置时，程序使用项目内 data/derived/medical_ops.db 的绝对路径。
# Compose 已固定使用容器内 /app/data/derived/medical_ops.db。
# MEDICAL_DATA_DIR=/absolute/path/to/source-data-root
# MEDICAL_DB_PATH=/absolute/path/to/medical_ops.db

# 支持 deepseek（默认）或 kimi；对应Key为空时使用本地规则。
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# 多个来源用英文逗号分隔，不要在未评估时使用通配符。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
