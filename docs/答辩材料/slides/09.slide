<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: 60 }}>
  <Box style={{ width: '100%', height: 8, background: '#1E4FA8', position: 'absolute', top: 0, left: 0 }} />
  <Box style={{ flexDirection: 'column', gap: 8, height: 112 }}>
    <Text style={{ fontSize: 18, color: '#1E4FA8', fontWeight: 'bold', letterSpacing: 1 }}>08 / 边界</Text>
    <Text style={{ fontSize: 38, fontWeight: 'bold', color: '#0E3F8C' }}>边界比演示更重要</Text>
    <Text style={{ fontSize: 20, color: '#4A5568' }}>哪些已经做到、哪些没有、哪些必须由后续验收补齐，必须分开说。</Text>
  </Box>

  <Box style={{ flexDirection: 'row', gap: 24, height: 370, marginTop: 16 }}>
    <Box style={{ width: 566, background: '#F0F5FC', border: '1px solid #C9DCF5', borderRadius: 10, padding: 22 }}>
      <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#0E3F8C' }}>本轮已实现</Text>
      <Text style={{ fontSize: 19, color: '#1A2230', lineHeight: 1.55 }}>六源加工；25张DDL与DWD宽表；8主题DWS；30项ADS三粒度；axios与5图表组件；图表下钻、同环比、系统CRUD；安全只读SQL、知识问答；35项测试、E2E10/10、安全13/13、对账11/11、负载120/120。</Text>
      <Box style={{ background: '#FFFFFF', borderRadius: 6, padding: 12 }}>
        <Text style={{ fontSize: 18, color: '#1E4FA8' }}>可用于课程演示和技术评审。</Text>
      </Box>
    </Box>

    <Box style={{ width: 570, background: '#FFF8E1', border: '1px solid #FFE082', borderRadius: 10, padding: 22 }}>
      <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#7A4F00' }}>未完成/未验证</Text>
      <Text style={{ fontSize: 19, color: '#5D4037', lineHeight: 1.55 }}>
        默认主题12个月接入（附加库已验证）；再补5类图表与独立科室看板；质量异常告警闭环；真实Key模型SQL；Docker实测；生产容量与渗透；Canvas点击与下载人工验收；正式试运行、培训与签字。
      </Text>
      <Box style={{ background: '#FFFFFF', borderRadius: 6, padding: 12 }}>
        <Text style={{ fontSize: 18, color: '#B03A35' }}>因此结论是“有条件通过”，不是“全部完成”。</Text>
      </Box>
    </Box>
  </Box>

  <Box style={{ height: 94, marginTop: 18, background: '#0E3F8C', borderRadius: 9, padding: 18, flexDirection: 'row', alignItems: 'center', gap: 22 }}>
    <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#FFFFFF' }}>答辩原则</Text>
    <Text style={{ fontSize: 21, color: '#D7E4F8' }}>不把配置当实测，不把页面当指标，不把固定题库当开放域能力，不把模拟数据当生产成果。</Text>
  </Box>

  <Box style={{ position: 'absolute', left: 60, right: 60, top: 674, flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 14, color: '#8B97A8' }}>医疗运营数据主题分析平台</Text>
    <Text style={{ fontSize: 14, color: '#1E4FA8' }}>09 / 10</Text>
  </Box>
</Slide>
