<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: 60 }}>
  <Box style={{ width: '100%', height: 8, background: '#1E4FA8', position: 'absolute', top: 0, left: 0 }} />
  <Box style={{ flexDirection: 'column', gap: 8, height: 112 }}>
    <Text style={{ fontSize: 18, color: '#1E4FA8', fontWeight: 'bold', letterSpacing: 1 }}>04 / 数仓成果</Text>
    <Text style={{ fontSize: 38, fontWeight: 'bold', color: '#0E3F8C' }}>八主题集市与三粒度 ADS</Text>
    <Text style={{ fontSize: 20, color: '#4A5568' }}>从“主题页面”走到“主题物理表”，从单一日指标走到可回刷的日/周/月结果。</Text>
  </Box>

  <Box style={{ flexDirection: 'row', gap: 24, height: 480, marginTop: 16 }}>
    <Box style={{ width: 700, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: 18 }}>
      <Text style={{ fontSize: 25, fontWeight: 'bold', color: '#0E3F8C' }}>8 张主题 DWS · 合计 7,679 行</Text>
      <Text style={{ fontSize: 18, color: '#4A5568', marginTop: 4, marginBottom: 12 }}>每张都按日期与科室建立组合主键，并有聚合一致性回归测试。</Text>
      <Box style={{ flexDirection: 'row', gap: 8, height: 72, marginBottom: 8 }}>
        <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 7, padding: 10 }}>
          <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1A2230' }}>门诊</Text>
          <Text style={{ fontSize: 16, color: '#4A5568' }}>人次 · 人数 · 急诊</Text>
        </Box>
        <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 7, padding: 10 }}>
          <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1A2230' }}>住院</Text>
          <Text style={{ fontSize: 16, color: '#4A5568' }}>床日 · 周转 · 住院日</Text>
        </Box>
      </Box>
      <Box style={{ flexDirection: 'row', gap: 8, height: 72, marginBottom: 8 }}>
        <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 7, padding: 10 }}>
          <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1A2230' }}>收入</Text>
          <Text style={{ fontSize: 16, color: '#4A5568' }}>门诊 · 住院 · 合计</Text>
        </Box>
        <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 7, padding: 10 }}>
          <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1A2230' }}>药品</Text>
          <Text style={{ fontSize: 16, color: '#4A5568' }}>药品收入 · 药占比</Text>
        </Box>
      </Box>
      <Box style={{ flexDirection: 'row', gap: 8, height: 72, marginBottom: 8 }}>
        <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 7, padding: 10 }}>
          <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1A2230' }}>耗材</Text>
          <Text style={{ fontSize: 16, color: '#4A5568' }}>耗材收入 · 耗占比</Text>
        </Box>
        <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 7, padding: 10 }}>
          <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1A2230' }}>病种</Text>
          <Text style={{ fontSize: 16, color: '#4A5568' }}>出院 · 均费 · 住院日</Text>
        </Box>
      </Box>
      <Box style={{ flexDirection: 'row', gap: 8, height: 72 }}>
        <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 7, padding: 10 }}>
          <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1A2230' }}>资源</Text>
          <Text style={{ fontSize: 16, color: '#4A5568' }}>床位 · 人力 · 人均</Text>
        </Box>
        <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 7, padding: 10 }}>
          <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1A2230' }}>患者服务</Text>
          <Text style={{ fontSize: 16, color: '#4A5568' }}>LIS · 异常率</Text>
        </Box>
      </Box>
    </Box>

    <Box style={{ width: 436, flexDirection: 'column', gap: 12 }}>
      <Box style={{ height: 124, background: '#E8EFF8', borderRadius: 9, padding: 16 }}>
        <Text style={{ fontSize: 18, color: '#4A5568' }}>ADS 全部结果</Text>
        <Text style={{ fontSize: 48, fontWeight: 'bold', color: '#0E3F8C', lineHeight: 1.1 }}>35,640</Text>
        <Text style={{ fontSize: 16, color: '#4A5568' }}>30项可算 × 日/周/月 × 科室/全院</Text>
      </Box>
      <Box style={{ height: 112, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 9, padding: 16 }}>
        <Text style={{ fontSize: 18, color: '#4A5568' }}>月度医疗收入（万元）</Text>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1.1 }}>1,529</Text>
        <Text style={{ fontSize: 16, color: '#4A5568' }}>5月最高，6月回落；需结合服务量解释</Text>
      </Box>
      <Chart
        style={{ height: 220 }}
        chartType='barChart'
        title='全院月度医疗收入（万元）'
        titleColor='#1A2230'
        axisColor='#8B97A8'
        legendColor='#4A5568'
        showLegend={false}
        showDataLabels={true}
        dataLabelColor='#1E4FA8'
        colors={['#1E4FA8']}
        background='#FFFFFF'
        data={[
          ['月份', '医疗收入'],
          ['4月', 1452.93],
          ['5月', 1528.92],
          ['6月', 1444.18],
        ]}
      />
    </Box>
  </Box>

  <Box style={{ position: 'absolute', left: 60, right: 60, top: 674, flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 14, color: '#8B97A8' }}>医疗运营数据主题分析平台</Text>
    <Text style={{ fontSize: 14, color: '#1E4FA8' }}>05 / 10</Text>
  </Box>
</Slide>
